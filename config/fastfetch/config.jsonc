{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "Fedora",
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "34",
            "title": "36"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "keyColor": "36"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": "  WM",
            "keyColor": "35"
        },
        {
            "type": "terminal",
            "key": "  Term",
            "keyColor": "35"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "35"
        },
        {
            "type": "packages",
            "key": " 󰏗 Pkgs",
            "keyColor": "32"
        },
        {
            "type": "uptime",
            "key": " 󰅐 Uptime",
            "keyColor": "32"
        },
        "break",
        {
            "type": "cpu",
            "key": " 󰍛 CPU",
            "keyColor": "36"
        },
        {
            "type": "gpu",
            "key": " 󰢮 GPU",
            "keyColor": "36"
        },
        {
            "type": "memory",
            "key": "  RAM",
            "keyColor": "33"
        },
        {
            "type": "disk",
            "key": " 󰋊 Disk",
            "keyColor": "33",
            "folders": "/"
        },
        {
            "type": "display",
            "key": " 󰍹 Display",
            "keyColor": "31"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}

# Cava — Console Audio Visualizer
# Tokyo Night themed bar visualizer

[general]
bars = 40
framerate = 60
sensitivity = 120
autosens = 1
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#7aa2f7'
gradient_color_2 = '#bb9af7'
gradient_color_3 = '#7dcfff'
gradient_color_4 = '#73daca'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0
gravity = 80
